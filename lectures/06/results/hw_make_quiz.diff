+def make_quiz(lecture: int) -> str:
+    """指定した回の用語から1つを選び、確認問題と答えを返す。
+
+    「第2回の確認問題を出して」のように、復習用の問題を求められたときに使う。
+    lecture には講義の回を1始まりの整数で指定する。
+    """
+    # 第6回 宿題（実装）: 範囲外の回では、理由と出題できる回を返し、モデルが利用者に伝えられるようにする
+    available = sorted({entry["lecture"] for entry in load_glossary()})
+    choices = "、".join(f"第{n}回" for n in available)
+    if lecture < 1:
+        return json.dumps(
+            {"error": f"lecture は1以上の整数で指定してください（受け取った値: {lecture}）。出題できる回: {choices}"},
+            ensure_ascii=False,
+        )
+    entries = [entry for entry in load_glossary() if entry["lecture"] == lecture]
+    if not entries:
+        return json.dumps(
+            {"error": f"第{lecture}回の用語は用語集にないため、出題できません。出題できる回: {choices}"},
+            ensure_ascii=False,
+        )
+    entry = random.choice(entries)
+    return json.dumps(
+        {"lecture": lecture, "question": f"「{entry['term']}」の意味は？", "answer": entry["definition"]},
+        ensure_ascii=False,
+    )
+
